msgid "Stripe webhooks are signature-verified against the raw request body. Orders and product entitlements are finalized from verified Stripe events, not from the browser success redirect. Day-based subscription intervals use Stripe recurring prices; seconds, minutes, and hours are represented as Taon-side entitlement expirations."
msgstr ""

#: src/lib/generated-docs-from-md-files/@taon-dev/e-commerce/README.component.html:15
msgid "Checkout and Stripe lifecycle"
