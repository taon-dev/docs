#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/contexts.component.html:1
msgid "Taon contexts"
msgstr ""

#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/contexts.component.html:2
msgid "A context is Taon's registration and runtime boundary for framework building blocks such as controllers, entities, repositories, providers, migrations, and subcontexts. Register a class in the context that owns its behavior rather than constructing it directly."
msgstr ""

#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/contexts.component.html:6
msgid "Abstract and active contexts"
msgstr ""

#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/contexts.component.html:7
msgid "An abstract context is reusable library configuration. An active context combines reusable contexts with application-specific host configuration and runtime settings. The CLI generates host configuration for deployable app contexts; keep application-specific configuration in the application's context."
msgstr ""

#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/contexts.component.html:12
