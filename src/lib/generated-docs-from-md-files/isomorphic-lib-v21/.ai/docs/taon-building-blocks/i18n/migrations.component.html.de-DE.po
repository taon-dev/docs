#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/migrations.component.html:305
msgid "<strong>Keep migrations in version control.</strong> Migration history should evolve alongside application code."
msgstr ""

#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/migrations.component.html:308
msgid "<strong>Review generated migrations before enabling them.</strong> Generated classes start with"
msgstr ""

#: src/lib/generated-docs-from-md-files/isomorphic-lib-v21/.ai/docs/taon-building-blocks/migrations.component.html:308
msgid "returning"
